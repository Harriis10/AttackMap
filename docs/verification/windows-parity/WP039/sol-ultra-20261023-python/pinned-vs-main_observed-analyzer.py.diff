+def _normalize_route_path(path: str) -> str:
+    """Leading slash, no `//` runs — the shape core's scanner gives the same
+    decorator, so the two analyzers' routes merge instead of duplicating."""
+    path = "/" + path.strip().lstrip("/")
+    while "//" in path:
+        path = path.replace("//", "/")
+    return path
+
