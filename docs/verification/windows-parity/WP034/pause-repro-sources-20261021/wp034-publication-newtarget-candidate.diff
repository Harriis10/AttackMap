+def safe_write_json_report(out_dir: str | Path, path: str | Path, value: object) -> None:
+    """Encode before target open, then bounded-copy through the legacy truncate policy."""
+    import json
+    import uuid
+
+    out, target = Path(out_dir), Path(path)
+    if target.exists() or target.is_symlink():
+        safe_write_text(out, target, json.dumps(value, indent=2) + "\n")
+        return
+    _check_output_target(out, target)
+    stage = target.with_name(f".{target.name}-{uuid.uuid4().hex}.tmp")
+    owned = False
+    try:
+        fd = _open_output_fd(out, stage, os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0))
+        owned = True
+        try:
+            handle = os.fdopen(fd, "w", encoding="utf-8", newline="")
+        except BaseException:
+            try:
+                os.close(fd)
+            except OSError:
+                pass
+            raise
+        with handle:
+            if type(value) is dict and all(type(key) is str for key in value):
+                if not value:
+                    handle.write("{}")
+                else:
+                    handle.write("{\n")
+                    first = True
+                    for key, section in value.items():
+                        if not first:
+                            handle.write(",\n")
+                        first = False
+                        handle.write("  " + json.dumps(key) + ": ")
+                        text = json.dumps(section, indent=2)
+                        handle.write(text.replace("\n", "\n  "))
+                        del text
+                    handle.write("\n}")
+            else:
+                handle.write(json.dumps(value, indent=2))
+            handle.write("\n")
