+def safe_write_text(out_dir: str | Path, path: str | Path, text: str, *, encoding: str = "utf-8") -> None:
+    """Write ``text`` to ``path`` without following symlinks.
+
+    Refuses when ``path`` is (or sits behind) a symlink, or resolves outside
