+def _copy_merge_representative(signal: Signal) -> Signal:
+    # Unknown mutable state keeps the legacy deep-copy contract.
+    rebuilt = {"properties", "origins", "conflicts"}
+    scalars = (str, int, float, bool, type(None))
+    if (type(signal) is not Signal or signal.__pydantic_extra__ or signal.__pydantic_private__
+            or type(signal.properties) is not dict
+            or any(type(key) is not str or type(value) is not str for key, value in signal.properties.items())
+            or any(type(value) not in scalars for name, value in signal.__dict__.items() if name not in rebuilt)):
+        return signal.model_copy(deep=True)
+    fields_set = signal.model_fields_set.copy()
+    copied = signal.model_copy(deep=False, update={"properties": dict(signal.properties), "origins": [], "conflicts": []})
+    copied.model_fields_set.clear()
+    copied.model_fields_set.update(fields_set)
+    return copied
