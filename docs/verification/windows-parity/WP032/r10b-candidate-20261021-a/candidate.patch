+def explicit_file_service_owners(hints) -> dict[str, FileServiceOwner]:
+    """Preserve exact file keys and existing lower-only name normalization."""
+    names_by_file: dict[str, set[str]] = {}
+    for name, file in hints:
+        if name:
+            names_by_file.setdefault(file, set()).add(name.lower())
+    return {file: FileServiceOwner("unique" if len(names) == 1 else "ambiguous", tuple(sorted(names)))
+            for file, names in names_by_file.items()}
