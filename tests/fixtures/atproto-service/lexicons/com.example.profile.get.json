{
  "lexicon": 1,
  "id": "com.example.profile.get",
  "defs": {
    "main": {
      "type": "query",
      "parameters": {
        "type": "object",
        "required": ["actor"],
        "properties": {
          "actor": { "type": "string", "format": "at-identifier" }
        }
      },
      "output": {
        "schema": {
          "type": "object",
          "required": ["did", "displayName"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "displayName": { "type": "string", "maxLength": 64 },
            "avatarCid": { "type": "string", "format": "cid-string" }
          }
        }
      }
    }
  }
}
