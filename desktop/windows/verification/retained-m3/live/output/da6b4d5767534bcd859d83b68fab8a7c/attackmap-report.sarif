            {
              "id": "path-traversal",
              "name": "Request input flows into a filesystem path (path traversal)",
              "shortDescription": {
                "text": "Request input flows into a filesystem path (path traversal)"
              },
              "fullDescription": {
                "text": "Request input flows into a filesystem path (path traversal)"
              },
              "help": {
                "text": "Never build filesystem paths from request input directly. Reduce it to a basename (secure_filename / path.basename), resolve it against a fixed base directory and verify the result stays inside it, or map an opaque id to a server-side path.",
                "markdown": "Never build filesystem paths from request input directly. Reduce it to a basename (secure_filename / path.basename), resolve it against a fixed base directory and verify the result stays inside it, or map an opaque id to a server-side path."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "taint-chain",
                  "taint-flow",
                  "input-handling",
                  "data-risk",
                  "external/cwe/cwe-022"
                ],
                "security-severity": "9.0",
