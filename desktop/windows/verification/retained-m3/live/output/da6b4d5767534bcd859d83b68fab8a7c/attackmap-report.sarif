            {
              "id": "unpinned-action",
              "name": "Unpinned GitHub Action (not pinned to a commit SHA)",
              "shortDescription": {
                "text": "Unpinned GitHub Action (not pinned to a commit SHA)"
              },
              "fullDescription": {
                "text": "Unpinned GitHub Action (not pinned to a commit SHA)"
              },
              "help": {
                "text": "Pin third-party actions to a full 40-character commit SHA (`uses: org/action@<sha>`), not a moving tag or branch. A tag/branch lets the action owner \u2014 or anyone who compromises them \u2014 change what runs in your pipeline. Dependabot can keep the pinned SHAs updated.",
                "markdown": "Pin third-party actions to a full 40-character commit SHA (`uses: org/action@<sha>`), not a moving tag or branch. A tag/branch lets the action owner \u2014 or anyone who compromises them \u2014 change what runs in your pipeline. Dependabot can keep the pinned SHAs updated."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "ci-security",
                  "supply-chain",
                  "external/cwe/cwe-829",
                  "external/cwe/cwe-1357"
                ],
