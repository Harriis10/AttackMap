            {
              "id": "default-token-permissions",
              "name": "Workflow relies on default GITHUB_TOKEN permissions",
              "shortDescription": {
                "text": "Workflow relies on default GITHUB_TOKEN permissions"
              },
              "fullDescription": {
                "text": "Workflow relies on default GITHUB_TOKEN permissions"
              },
              "help": {
                "text": "Add a top-level `permissions:` block (e.g. `permissions: { contents: read }`) and grant extra scopes per job. Without it the token gets the repository/organization default, which is read/write on many older repositories and organizations.",
                "markdown": "Add a top-level `permissions:` block (e.g. `permissions: { contents: read }`) and grant extra scopes per job. Without it the token gets the repository/organization default, which is read/write on many older repositories and organizations."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
