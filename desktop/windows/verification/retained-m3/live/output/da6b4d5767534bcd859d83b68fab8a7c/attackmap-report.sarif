            {
              "id": "eval",
              "name": "Request-reachable code execution via eval",
              "shortDescription": {
                "text": "Request-reachable code execution via eval"
              },
              "fullDescription": {
                "text": "Request-reachable code execution via eval"
              },
              "help": {
                "text": "Never pass request-derived data to eval. Use a domain-specific parser or an explicit allow-list of operations.",
                "markdown": "Never pass request-derived data to eval. Use a domain-specific parser or an explicit allow-list of operations."
              },
              "defaultConfiguration": {
