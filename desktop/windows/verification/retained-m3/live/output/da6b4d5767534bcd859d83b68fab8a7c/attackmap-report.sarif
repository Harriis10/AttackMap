            {
              "id": "unsafe-deserialization",
              "name": "Request-reachable unsafe deserialization",
              "shortDescription": {
                "text": "Request-reachable unsafe deserialization"
              },
              "fullDescription": {
                "text": "Request-reachable unsafe deserialization"
              },
              "help": {
                "text": "Do not deserialize attacker-controlled data with pickle/marshal/yaml.load/ObjectInputStream/unserialize. Use a data-only format (JSON) with a schema, or a safe loader (yaml.safe_load).",
                "markdown": "Do not deserialize attacker-controlled data with pickle/marshal/yaml.load/ObjectInputStream/unserialize. Use a data-only format (JSON) with a schema, or a safe loader (yaml.safe_load)."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
