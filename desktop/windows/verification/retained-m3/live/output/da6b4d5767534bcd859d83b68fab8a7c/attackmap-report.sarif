            {
              "id": "curl-pipe-shell",
              "name": "Remote script piped into a shell in CI (curl | sh)",
              "shortDescription": {
                "text": "Remote script piped into a shell in CI (curl | sh)"
              },
              "fullDescription": {
                "text": "Remote script piped into a shell in CI (curl | sh)"
              },
              "help": {
                "text": "`curl \u2026 | sh` runs whatever the server returns at build time, with the job's token and secrets in scope. Download to a file, verify a pinned checksum or signature, then execute \u2014 or use a pinned action/package instead.",
                "markdown": "`curl \u2026 | sh` runs whatever the server returns at build time, with the job's token and secrets in scope. Download to a file, verify a pinned checksum or signature, then execute \u2014 or use a pinned action/package instead."
              },
