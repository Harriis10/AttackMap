            {
              "id": "unauth-state-change",
              "name": "State-changing routes are reachable without an authentication control",
              "shortDescription": {
                "text": "State-changing routes are reachable without an authentication control"
              },
              "fullDescription": {
                "text": "State-changing routes are reachable without an authentication control"
              },
              "help": {
                "text": "Require authentication (and server-side authorization) on every state-changing endpoint \u2014 attach an auth middleware/guard to the route or its router, a dependency/decorator on the handler, or a global policy that defaults to deny. Confirm the control actually runs before the handler mutates state.",
                "markdown": "Require authentication (and server-side authorization) on every state-changing endpoint \u2014 attach an auth middleware/guard to the route or its router, a dependency/decorator on the handler, or a global policy that defaults to deny. Confirm the control actually runs before the handler mutates state."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "exposed-endpoint",
                  "auth-missing",
                  "state-changing",
                  "external/cwe/cwe-306"
                ],
                "security-severity": "6.8",
