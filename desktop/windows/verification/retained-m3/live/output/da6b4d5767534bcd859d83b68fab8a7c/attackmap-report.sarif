            {
              "id": "upload-route",
              "name": "Upload or import routes expand attacker-controlled input handling",
              "shortDescription": {
                "text": "Upload or import routes expand attacker-controlled input handling"
              },
              "fullDescription": {
                "text": "Upload or import routes expand attacker-controlled input handling"
              },
              "help": {
                "text": "Constrain accepted formats, isolate parsers, scan uploaded content, and treat imported files as untrusted all the way through storage and processing.",
                "markdown": "Constrain accepted formats, isolate parsers, scan uploaded content, and treat imported files as untrusted all the way through storage and processing."
              },
