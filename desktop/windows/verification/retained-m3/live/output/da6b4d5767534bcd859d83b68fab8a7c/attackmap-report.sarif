            {
              "id": "ssrf",
              "name": "Request-reachable server-side request forgery (SSRF)",
              "shortDescription": {
                "text": "Request-reachable server-side request forgery (SSRF)"
              },
              "fullDescription": {
                "text": "Request-reachable server-side request forgery (SSRF)"
              },
