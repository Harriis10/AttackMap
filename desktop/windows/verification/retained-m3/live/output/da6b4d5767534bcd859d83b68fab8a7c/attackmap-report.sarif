            {
              "id": "weak-csp",
              "name": "Content-Security-Policy allows unsafe-inline/unsafe-eval",
              "shortDescription": {
                "text": "Content-Security-Policy allows unsafe-inline/unsafe-eval"
              },
              "fullDescription": {
                "text": "Content-Security-Policy allows unsafe-inline/unsafe-eval"
              },
              "help": {
                "text": "Remove `'unsafe-inline'` and `'unsafe-eval'` from the CSP; use nonces or hashes for inline scripts. These directives largely defeat CSP's XSS protection.",
                "markdown": "Remove `'unsafe-inline'` and `'unsafe-eval'` from the CSP; use nonces or hashes for inline scripts. These directives largely defeat CSP's XSS protection."
              },
