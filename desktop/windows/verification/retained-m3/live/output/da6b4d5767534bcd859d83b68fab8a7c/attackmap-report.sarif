{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "AttackMap",
          "version": "1.5.1",
          "informationUri": "https://github.com/mlaify/AttackMap",
          "rules": [
            {
              "id": "exposed-admin-route",
              "name": "Administrative routes appear reachable from the main application surface",
              "shortDescription": {
                "text": "Administrative routes appear reachable from the main application surface"
              },
              "fullDescription": {
                "text": "Administrative routes appear reachable from the main application surface"
              },
              "help": {
                "text": "Require strong authentication and explicit server-side authorization on every admin action, and move admin routes behind a narrower exposure boundary where possible.",
                "markdown": "Require strong authentication and explicit server-side authorization on every admin action, and move admin routes behind a narrower exposure boundary where possible."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "exposed-endpoint",
                  "auth-missing",
                  "privileged",
                  "external/cwe/cwe-285"
                ],
                "security-severity": "9.0",
                "cwe": [
                  "CWE-285"
                ],
                "owasp": [
                  "A01:2021",
                  "API5:2023"
                ],
                "asvs": [
                  "V4.1.3"
                ],
                "attack": [
                  "T1078",
                  "T1068",
                  "T1098"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/285.html",
              "relationships": [
                {
                  "target": {
                    "id": "285",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "auth-outlier",
              "name": "Authorization outlier \u2014 route missing an auth check its siblings enforce",
              "shortDescription": {
                "text": "Authorization outlier \u2014 route missing an auth check its siblings enforce"
              },
              "fullDescription": {
                "text": "Authorization outlier \u2014 route missing an auth check its siblings enforce"
              },
              "help": {
                "text": "Confirm whether the flagged route is intended to be public. If not, apply the same auth/authorization guard its sibling routes use (decorator, middleware, or policy). Inconsistent enforcement across a resource cohort is a common source of broken access control.",
                "markdown": "Confirm whether the flagged route is intended to be public. If not, apply the same auth/authorization guard its sibling routes use (decorator, middleware, or policy). Inconsistent enforcement across a resource cohort is a common source of broken access control."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "anomaly",
                  "external/cwe/cwe-862"
                ],
                "security-severity": "9.0",
                "cwe": [
                  "CWE-862"
                ],
                "owasp": [
                  "A01:2021",
                  "API5:2023"
                ],
                "asvs": [
                  "V4.1.3",
                  "V13.1.4"
                ],
                "attack": [
                  "T1190"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/862.html",
              "relationships": [
                {
                  "target": {
                    "id": "862",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
            },
            {
              "id": "hardcoded-secret",
              "name": "Hard-coded secret literals were found in source or config",
              "shortDescription": {
                "text": "Hard-coded secret literals were found in source or config"
              },
              "fullDescription": {
                "text": "Hard-coded secret literals were found in source or config"
              },
              "help": {
                "text": "Rotate every detected credential immediately, purge it from git history, and move to environment-injected or vault-managed values. Anyone with read access to the repository already has these secrets.",
                "markdown": "Rotate every detected credential immediately, purge it from git history, and move to environment-injected or vault-managed values. Anyone with read access to the repository already has these secrets."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secret-exposure",
                  "data-risk",
                  "hardcoded-literal",
                  "external/cwe/cwe-798"
                ],
                "security-severity": "9.0",
                "cwe": [
                  "CWE-798"
                ],
                "owasp": [
                  "A07:2021"
                ],
                "asvs": [
                  "V2.10.4",
                  "V6.4.1"
                ],
                "attack": [
                  "T1552.001"
                ]
              },
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html",
              "relationships": [
                {
                  "target": {
                    "id": "798",
                    "toolComponent": {
                      "name": "CWE"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ]
