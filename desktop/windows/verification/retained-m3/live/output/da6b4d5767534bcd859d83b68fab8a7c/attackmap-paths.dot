digraph AttackPaths {
  rankdir=TB;
  node [shape=box, style=rounded];
  subgraph cluster_p1 {
    label="Distributed service trust-chain abuse";
    style=rounded;
    p1_0 [label="Entry: Attacker reaches EXPOSE container:80 in infrastructure/docker-compose.yml"];
