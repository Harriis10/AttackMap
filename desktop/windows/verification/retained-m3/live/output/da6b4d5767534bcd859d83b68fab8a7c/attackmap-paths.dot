    p1_2 [label="Sink: Influence reaches database, creating a plausible unauthorized downstream action path"];
    p1_3 [label="Evidence: confidence=0.80; route EXPOSE container:80 in infrastructure/docker-compose.yml; entry service from file-local hint: juice-shop-net; database sink in service juice-shop-net: redis (infrastructure/docker-compose.yml)"];
    p1_4 [label="Impact: A public API foothold can propagate across `juice-shop-net` and affect database if service boundaries or downstream trust checks are weak.", style="rounded,filled", fillcolor="#fee", color="#c33"];
