<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DefineConstants>$(DefineConstants);DIAGRAM_STANDALONE_PREVIEW</DefineConstants>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <Compile Include="../../AttackMap.NativeSpike/Diagram/*.cs" Link="Diagram/%(Filename)%(Extension)" />
    <Compile Include="../../AttackMap.NativeSpike/SelectedArtifacts.cs" Link="SelectedArtifacts.cs" />
    <Compile Include="../../AttackMap.NativeSpike/ExportSelection.cs" Link="ExportSelection.cs" />
    <Compile Include="../../AttackMap.NativeSpike/RunPresentation.cs" Link="RunPresentation.cs" />
  </ItemGroup>
</Project>