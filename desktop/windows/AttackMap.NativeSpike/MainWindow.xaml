<Window x:Class="AttackMap.NativeSpike.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AttackMap.NativeSpike" Title="AttackMap">
 <Grid Background="{ThemeResource AttackCanvasBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <MenuBar x:Name="CommandMenu" Padding="12,0" AutomationProperties.Name="Application commands">
   <MenuBarItem Title="File">
    <MenuFlyoutItem Text="Choose repository" Click="ChooseRepository" KeyboardAcceleratorTextOverride="Ctrl+Shift+O"/>
    <MenuFlyoutItem Text="Open report" Click="OpenReport" KeyboardAcceleratorTextOverride="Ctrl+O"/>
    <MenuFlyoutSeparator/>
    <MenuFlyoutItem Text="Export displayed JSON" Click="ExportJson" KeyboardAcceleratorTextOverride="Ctrl+E"/>
    <MenuFlyoutItem Text="Export displayed review Markdown" Click="ExportMarkdown"/>
   </MenuBarItem>
   <MenuBarItem Title="Scan">
    <MenuFlyoutItem Text="Start scan" Click="MenuScan" IsEnabled="{x:Bind ScanButton.IsEnabled, Mode=OneWay}" KeyboardAcceleratorTextOverride="F5"/>
    <MenuFlyoutItem Text="Cancel" Click="MenuCancel" IsEnabled="{x:Bind CancelButton.IsEnabled, Mode=OneWay}" KeyboardAcceleratorTextOverride="Esc"/>
   </MenuBarItem>
   <MenuBarItem Title="View">
    <MenuFlyoutSubItem Text="Theme">
     <ToggleMenuFlyoutItem x:Name="ThemeSystemItem" Text="Use system theme" Click="ThemeSystemClick" IsChecked="True"/>
     <ToggleMenuFlyoutItem x:Name="ThemeLightItem" Text="Light" Click="ThemeLightClick"/>
     <ToggleMenuFlyoutItem x:Name="ThemeDarkItem" Text="Dark" Click="ThemeDarkClick"/>
    </MenuFlyoutSubItem>
    <MenuFlyoutItem Text="Settings" Click="MenuSettings" KeyboardAcceleratorTextOverride="Ctrl+,"/>
    <MenuFlyoutItem Text="History" Click="MenuHistory" KeyboardAcceleratorTextOverride="Ctrl+H"/>
   </MenuBarItem>
  </MenuBar>
 <NavigationView Grid.Row="1" x:Name="Navigation" SelectionChanged="Navigate" IsBackButtonVisible="Collapsed" OpenPaneLength="208" Background="{ThemeResource AttackCanvasBrush}">
  <NavigationView.PaneHeader><StackPanel Margin="16,18,12,20" Spacing="4"><TextBlock Text="AttackMap" FontSize="22" FontWeight="SemiBold" Foreground="{ThemeResource AttackTextBrush}"/><TextBlock Text="Security workspace" FontSize="12" Foreground="{ThemeResource AttackMutedBrush}"/></StackPanel></NavigationView.PaneHeader>
  <NavigationView.MenuItems>
   <NavigationViewItem Content="Overview" Icon="Home"/>
   <NavigationViewItem Content="Findings" Icon="Find"/>
   <NavigationViewItem Content="Architecture" Icon="Map"/>
   <NavigationViewItem Content="Inventory" Icon="Library"/>
   <NavigationViewItem Content="Reports" Icon="Document"/>
   <NavigationViewItem Content="History" Icon="Clock"/>
   <NavigationViewItem Content="Scan options" Icon="Manage"/>
  </NavigationView.MenuItems>
  <Grid Padding="24,16" RowSpacing="16" Background="{ThemeResource AttackCanvasBrush}">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid ColumnSpacing="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="WorkspaceLabel" FontSize="13" Foreground="{ThemeResource AttackMutedBrush}" Text="No repository selected" VerticalAlignment="Center" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
    <Button Grid.Column="1" Content="Open report" Click="OpenReport" AutomationProperties.Name="Open canonical AttackMap JSON report"/>
    <Button Grid.Column="2" Content="Choose repository" Click="ChooseRepository"/>
    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
     <Button x:Name="ScanButton" Style="{StaticResource AccentButtonStyle}" Content="Start scan" Click="ScanRepository" MinHeight="36" AutomationProperties.AutomationId="scan"/>
     <Button x:Name="CancelButton" Content="Cancel" Click="CancelScan" IsEnabled="False" MinHeight="36" AutomationProperties.AutomationId="cancel"/>
    </StackPanel>
   </Grid>
   <StackPanel Grid.Row="1" Spacing="8">
    <TextBlock x:Name="Heading" Text="Overview" Style="{StaticResource TitleTextBlockStyle}" FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource AttackTextBrush}" Margin="0"/>
    <Border Padding="0,0,0,4"><TextBlock x:Name="Status" Text="Choose a repository to scan, or open a saved report." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Foreground="{ThemeResource AttackTextBrush}"/></Border>
   </StackPanel>
   <Grid x:Name="FindingsPanel" Grid.Row="2" Visibility="Collapsed" ColumnSpacing="16" RowSpacing="12" SizeChanged="ResponsivePanels">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid RowSpacing="8">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBox x:Name="Search" PlaceholderText="Filter findings" TextChanged="Filter" AutomationProperties.Name="Filter findings by title severity or source"/>
     <ListView x:Name="Findings" Grid.Row="1" Background="{ThemeResource AttackSurfaceBrush}" BorderBrush="{ThemeResource AttackStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="6" SelectionChanged="SelectFinding" AutomationProperties.Name="Findings">
      <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Spacing="10" Padding="10,12">
       <Border Background="{Binding SeverityBrush}" CornerRadius="4" Padding="9,3" VerticalAlignment="Top" MinWidth="64">
        <TextBlock Text="{Binding SeverityLabel}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       </Border>
       <StackPanel Spacing="4" VerticalAlignment="Top">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource AttackMutedBrush}" FontSize="12" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
    <ScrollViewer x:Name="FindingInspector" Grid.Column="1" Background="{ThemeResource AttackSurfaceBrush}" BorderBrush="{ThemeResource AttackStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
     <TextBlock Text="Finding detail" Style="{StaticResource SubtitleTextBlockStyle}"/>
     <Border x:Name="FindingSeverityChip" CornerRadius="4" Padding="9,3" HorizontalAlignment="Left" Visibility="Collapsed">
      <TextBlock x:Name="FindingSeverityLabel" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
     </Border>
     <TextBlock x:Name="Detail" Text="Select a finding for evidence and recommendation." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <Button Content="Inspect live source locations" Click="InspectSource"/>
     <TextBlock x:Name="SourceWarning" Text="Source files may have changed since the scan." TextWrapping="Wrap"/>
     <ListView x:Name="SourceLocations" MaxHeight="180" AutomationProperties.Name="Inspected source locations" SelectionMode="Single">
      <ListView.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap"/><TextBlock Text="{Binding Warning}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Show folder" Click="RevealSource"/><Button Content="Copy location" Click="CopySource"/></StackPanel>
     <Expander Header="Suppress this finding" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><local:SuppressionPanel x:Name="Suppression"/></Expander>
    </StackPanel></ScrollViewer>
   </Grid>
   <ScrollViewer x:Name="HistoryPanel" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource AttackCardStyle}"><local:HistoryComparisonView x:Name="History"/></Border></ScrollViewer>
   <ScrollViewer x:Name="OverviewPanel" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16" VerticalAlignment="Top"><Border Style="{StaticResource AttackCardStyle}" MaxWidth="960" HorizontalAlignment="Left"><StackPanel Spacing="12">

    <TextBlock Text="SECURITY REVIEW" Style="{StaticResource AttackSectionLabelStyle}"/>
    <TextBlock Text="System overview" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AttackTextBrush}"/>
    <TextBlock x:Name="OverviewText" FontSize="16" LineHeight="25" Foreground="{ThemeResource AttackTextBrush}" Text="Choose a repository and start a scan, or open a saved report. AI and CVE lookup are off by default." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <TextBlock Text="Results will appear in Findings, Architecture and Inventory. Read or export the review from Reports." TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border Style="{StaticResource AttackCardStyle}" MaxWidth="960" HorizontalAlignment="Left"><StackPanel Spacing="12">
    <TextBlock Text="RUN DETAILS AND COVERAGE" Style="{StaticResource AttackSectionLabelStyle}"/>
    <TextBlock x:Name="RunSummary" Text="Displayed report: none" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <TextBlock x:Name="CoverageSummary" Text="No report coverage available." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <TextBlock x:Name="DiagnosticPath" Text="No native scan diagnostics selected." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="Reveal last scan folder" Click="RevealScanFolder"/>
     <Button Content="Retry scan with current settings" Click="ScanRepository"/>
    </StackPanel>
   </StackPanel></Border></StackPanel></ScrollViewer>
   <ScrollViewer x:Name="ScanOptionsPanel" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource AttackCardStyle}" VerticalAlignment="Top" MaxWidth="960" HorizontalAlignment="Left"><StackPanel Spacing="16">
    <TextBlock Text="SCAN SETUP" Style="{StaticResource AttackSectionLabelStyle}"/>
    <TextBlock Text="Scan options" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{ThemeResource AttackTextBrush}"/>
    <TextBlock Text="Set the engine used for local analysis. Options apply to the next scan; optional network features stay off unless enabled." TextWrapping="Wrap"/>
    <TextBox x:Name="PythonPath" Header="Absolute engine executable: Python with AttackMap, or frozen attackmap.exe" PlaceholderText="C:\path\to\python.exe or attackmap.exe"/>
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button Content="Save local settings" Click="SaveLocalSettings"/>
     <Button Content="Clear saved settings" Click="ClearLocalSettings"/>
    </StackPanel>
    <TextBlock x:Name="NetworkDisclosure" Text="AI off; CVE lookup off (local scan)" TextWrapping="Wrap" Foreground="{ThemeResource AttackMutedBrush}"/>
    <Expander x:Name="AdvancedOptions" Header="Advanced scan options" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="12" Padding="0,8,0,0">
     <CheckBox x:Name="RecallOption" Content="Higher recall (may produce more uncertain findings)"/>
     <CheckBox x:Name="StrictAnalyzersOption" Content="Fail on analyzer errors"/>
     <CheckBox x:Name="NoSuppressOption" Content="Do not apply saved suppressions"/>
     <CheckBox x:Name="CveOption" Checked="NetworkOptionChanged" Unchecked="NetworkOptionChanged" Content="CVE lookup: contacts OSV and sends dependency names/versions"/>
     <TextBlock Text="CVE lookup is off by default. No analyzer auto-install. Configure optional AI explicitly in Settings." TextWrapping="Wrap"/>
     <TextBox x:Name="ModulesOption" Header="Installed analyzer names (blank = automatic selection)" PlaceholderText="javascript-web, config"/>
     <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SecretsHistoryOption" Header="Local secret history: commits, 0 disables (0 to 10000)" Text="0"/>
      <TextBox x:Name="TimeoutOption" Grid.Column="1" Header="Worker timeout in seconds (1 to 86400)" Text="600"/>
     </Grid>
     <Button Content="Explore synthetic sample" Click="LoadFixture" HorizontalAlignment="Left" AutomationProperties.Name="Load synthetic 10000 finding fixture"/>
    </StackPanel></Expander>
   </StackPanel></Border></ScrollViewer>
   <ScrollViewer x:Name="ReportsPanel" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource AttackCardStyle}"><StackPanel Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Export JSON" Click="ExportJson"/><Button Content="Export Markdown" Click="ExportMarkdown"/><Button Content="Export to PDF" Click="ExportPdf" AutomationProperties.Name="Export displayed review as PDF via headless Edge or Chrome"/><Button Content="Export to HTML" Click="ExportHtml" AutomationProperties.Name="Export displayed review as standalone HTML"/><Button Content="Show folder" Click="RevealReportFolder"/></StackPanel>
    <Border Background="{ThemeResource AttackRaisedBrush}" BorderBrush="{ThemeResource AttackStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="18"><StackPanel Spacing="12">
     <TextBlock Text="AI-assisted defensive review" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource AttackTextBrush}"/>
     <TextBlock Text="Optional generated prose, not verified findings. Read its scope and uncertainty alongside the core evidence. Displaying a saved review makes no provider request." TextWrapping="Wrap"/>
     <Button x:Name="AiReviewButton" Content="Open selected run AI review" Click="OpenAiReview" HorizontalAlignment="Left"/>
     <TextBlock x:Name="AiReviewStatus" Text="No AI review loaded. AI is off by default; a review exists only when explicitly generated for the selected run." TextWrapping="Wrap" Foreground="{ThemeResource AttackMutedBrush}"/>
     <local:MarkdownView x:Name="AiReviewText"/>
    </StackPanel></Border>
    <Expander x:Name="RawArtifacts" Header="Raw artifacts" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10">
     <TextBlock Text="Read-only text from the exact displayed generation. Artifacts may contain source excerpts and model assessments; these are not runtime verification." TextWrapping="Wrap" Foreground="{ThemeResource AttackMutedBrush}"/>
     <StackPanel Orientation="Horizontal" Spacing="8">
      <Button x:Name="ArtifactListButton" Content="List selected run artifacts" Click="ListArtifacts"/>
      <Button x:Name="ArtifactReadButton" Content="Read selected artifact" Click="ReadArtifact"/>
     </StackPanel>
     <TextBlock x:Name="ArtifactStatus" Text="Legacy imports support canonical JSON export; verified generations also support artifact browsing." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <ListView x:Name="ArtifactRows" MaxHeight="220" SelectionMode="Single" AutomationProperties.Name="Selected run artifacts" Background="{ThemeResource AttackSurfaceBrush}" BorderBrush="{ThemeResource AttackStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="4"><ListView.ItemTemplate><DataTemplate><StackPanel Padding="8,7" Spacing="2">
      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Role}" Foreground="{ThemeResource AttackMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
     </StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
     <Border Background="{ThemeResource AttackRaisedBrush}" BorderBrush="{ThemeResource AttackStrokeBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ArtifactText" FontFamily="Consolas" FontSize="12" LineHeight="18" Text="Choose an artifact to inspect its verified text." TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></Border>
    </StackPanel></Expander>
    <TextBlock Text="Review supplied by the engine. Static conclusions remain subject to the evidence and uncertainty stated in this report. Markdown is displayed as selectable text." TextWrapping="Wrap"/>
    <local:MarkdownView x:Name="ReviewText"/>
   </StackPanel></Border></ScrollViewer>
   <ScrollViewer x:Name="ProviderPanel" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource AttackCardStyle}" VerticalAlignment="Top" HorizontalAlignment="Left"><local:ProviderSettingsView x:Name="Provider" VerticalAlignment="Top"/></Border></ScrollViewer>
   <Grid x:Name="StructurePanel" Grid.Row="2" Visibility="Collapsed" RowSpacing="8" ColumnSpacing="16" SizeChanged="ResponsivePanels">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="0"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Expander Grid.ColumnSpan="2" Header="Coverage and modeling limitations" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"><ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="StructureNotes" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer></Expander>
    <Grid Grid.Row="1" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBox x:Name="StructureSearch" Header="Filter supplied records" TextChanged="FilterStructure" AutomationProperties.Name="Filter architecture or inventory supplied records"/>
     <ListView x:Name="StructureRecords" Grid.Row="1" Background="{ThemeResource AttackSurfaceBrush}" BorderBrush="{ThemeResource AttackStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="6" SelectionChanged="SelectStructure" AutomationProperties.Name="Supplied architecture and inventory records">
      <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel/></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemTemplate><DataTemplate><StackPanel Padding="8" Spacing="4"><TextBlock Text="{Binding Title}" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
    <ScrollViewer x:Name="StructureInspector" Grid.Row="1" Grid.Column="1" Background="{ThemeResource AttackSurfaceBrush}" BorderBrush="{ThemeResource AttackStrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="20" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="StructureDetail" Text="Select a supplied record for evidence." TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
   </Grid>
  </Grid>
 </NavigationView>
 </Grid>
</Window>
