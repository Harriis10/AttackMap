<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ResourceDictionary.ThemeDictionaries>
  <ResourceDictionary x:Key="Light">
   <SolidColorBrush x:Key="AttackCanvasBrush" Color="#F4F6F9"/>
   <SolidColorBrush x:Key="AttackSurfaceBrush" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="AttackRaisedBrush" Color="#EDF1F6"/>
   <SolidColorBrush x:Key="AttackStrokeBrush" Color="#D7DFE9"/>
   <SolidColorBrush x:Key="AttackTextBrush" Color="#14243B"/>
   <SolidColorBrush x:Key="AttackMutedBrush" Color="#526680"/>
   <SolidColorBrush x:Key="AttackAccentBrush" Color="#0078D4"/>
   <SolidColorBrush x:Key="AttackAccentTextBrush" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="AttackBrandBrush" Color="#10243D"/>
   <SolidColorBrush x:Key="AttackBrandTextBrush" Color="#EFF7FF"/>   <SolidColorBrush x:Key="MenuBarItemBackground" Color="#F4F6F9"/>
   <SolidColorBrush x:Key="MenuBarItemForeground" Color="#14243B"/>
   <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="#E5EBF2"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundPointerOver" Color="#14243B"/>
   <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="#D7E1ED"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundPressed" Color="#14243B"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundDisabled" Color="#778496"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="Dark">
   <SolidColorBrush x:Key="AttackCanvasBrush" Color="#101721"/>
   <SolidColorBrush x:Key="AttackSurfaceBrush" Color="#17212E"/>
   <SolidColorBrush x:Key="AttackRaisedBrush" Color="#202D3D"/>
   <SolidColorBrush x:Key="AttackStrokeBrush" Color="#344457"/>
   <SolidColorBrush x:Key="AttackTextBrush" Color="#E8F0FA"/>
   <SolidColorBrush x:Key="AttackMutedBrush" Color="#A5B7CD"/>
   <SolidColorBrush x:Key="AttackAccentBrush" Color="#48B5FF"/>
   <SolidColorBrush x:Key="AttackAccentTextBrush" Color="#07182A"/>
   <SolidColorBrush x:Key="AttackBrandBrush" Color="#10243D"/>
   <SolidColorBrush x:Key="AttackBrandTextBrush" Color="#EFF7FF"/>   <SolidColorBrush x:Key="MenuBarItemBackground" Color="#101721"/>
   <SolidColorBrush x:Key="MenuBarItemForeground" Color="#E8F0FA"/>
   <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="#27364A"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundPointerOver" Color="#E8F0FA"/>
   <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="#344457"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundPressed" Color="#E8F0FA"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundDisabled" Color="#8B99AC"/>
  </ResourceDictionary>
  <ResourceDictionary x:Key="HighContrast">
   <SolidColorBrush x:Key="AttackCanvasBrush" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="AttackSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="AttackRaisedBrush" Color="{ThemeResource SystemColorButtonFaceColor}"/>
   <SolidColorBrush x:Key="AttackStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="AttackTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="AttackMutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="AttackAccentBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="AttackAccentTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}"/>
   <SolidColorBrush x:Key="AttackBrandBrush" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="AttackBrandTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>   <SolidColorBrush x:Key="MenuBarItemBackground" Color="{ThemeResource SystemColorWindowColor}"/>
   <SolidColorBrush x:Key="MenuBarItemForeground" Color="{ThemeResource SystemColorWindowTextColor}"/>
   <SolidColorBrush x:Key="MenuBarItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}"/>
   <SolidColorBrush x:Key="MenuBarItemBackgroundPressed" Color="{ThemeResource SystemColorHighlightColor}"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundPressed" Color="{ThemeResource SystemColorHighlightTextColor}"/>
   <SolidColorBrush x:Key="MenuBarItemForegroundDisabled" Color="{ThemeResource SystemColorGrayTextColor}"/>
  </ResourceDictionary>
 </ResourceDictionary.ThemeDictionaries>
 <Style x:Key="AttackCardStyle" TargetType="Border">
  <Setter Property="Background" Value="{ThemeResource AttackSurfaceBrush}"/>
  <Setter Property="BorderBrush" Value="{ThemeResource AttackStrokeBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Padding" Value="16"/>
 </Style>
 <Style x:Key="AttackSectionLabelStyle" TargetType="TextBlock">
  <Setter Property="FontSize" Value="12"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="CharacterSpacing" Value="110"/>
  <Setter Property="Foreground" Value="{ThemeResource AttackMutedBrush}"/>
 </Style>
 <Style TargetType="Button">
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="Padding" Value="14,8"/>
  <Setter Property="CornerRadius" Value="6"/>
 </Style>
 <Style TargetType="TextBox">
  <Setter Property="MinHeight" Value="36"/>
  <Setter Property="CornerRadius" Value="6"/>
 </Style>
 <Style TargetType="Expander">
  <Setter Property="Background" Value="{ThemeResource AttackSurfaceBrush}"/>
  <Setter Property="BorderBrush" Value="{ThemeResource AttackStrokeBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="8"/>
 </Style> <Style TargetType="MenuBar">
  <Setter Property="Background" Value="{ThemeResource AttackCanvasBrush}"/>
  <Setter Property="Foreground" Value="{ThemeResource AttackTextBrush}"/>
  <Setter Property="Padding" Value="8,2"/>
 </Style>
 <Style TargetType="MenuBarItem">
  <Setter Property="Foreground" Value="{ThemeResource AttackTextBrush}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Padding" Value="12,8"/>
  <Setter Property="CornerRadius" Value="6"/>
 </Style>
</ResourceDictionary>
