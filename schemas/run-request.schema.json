        "fail_on_new_suppression": {
          "default": false,
          "network_impact": "none",
          "supported": true,
          "title": "Fail On New Suppression",
          "type": "boolean",
          "unit": "boolean"
        },
        "strict_suppressions": {
          "default": false,
          "network_impact": "none",
          "supported": true,
          "title": "Strict Suppressions",
