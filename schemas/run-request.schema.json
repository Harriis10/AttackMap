    "ScanOptionsV15": {
      "description": "Schema 1.5 adds an explicit, offline versioned analyzer profile.",
      "properties": {
        "recall": {
          "default": false,
          "title": "Recall",
          "type": "boolean"
        },
        "strict_analyzers": {
          "default": false,
          "title": "Strict Analyzers",
          "type": "boolean"
        },
        "no_suppress": {
          "default": false,
          "title": "No Suppress",
          "type": "boolean"
        },
        "cve": {
          "default": false,
          "title": "Cve",
          "type": "boolean"
        },
        "secrets_history": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Secrets History",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 600,
          "maximum": 86400,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "provider": {
          "$ref": "#/$defs/ProviderOptionsV13"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Absolute local baseline report file.",
          "network_impact": "none",
          "supported": true,
          "title": "Baseline",
          "unit": "absolute_file_path"
        },
        "suppress_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Absolute local suppression file.",
          "network_impact": "none",
          "supported": true,
          "title": "Suppress File",
          "unit": "absolute_file_path"
        },
        "fail_on_new_high": {
          "default": false,
          "network_impact": "none",
          "supported": true,
          "title": "Fail On New High",
          "type": "boolean",
          "unit": "boolean"
        },
        "fail_on_new_suppression": {
          "default": false,
          "network_impact": "none",
          "supported": true,
          "title": "Fail On New Suppression",
          "type": "boolean",
          "unit": "boolean"
        },
        "strict_suppressions": {
          "default": false,
          "network_impact": "none",
          "supported": true,
          "title": "Strict Suppressions",
          "type": "boolean",
          "unit": "boolean"
        },
        "isolated_analyzers": {
          "default": false,
          "network_impact": "none",
          "supported": true,
          "title": "Isolated Analyzers",
          "type": "boolean",
          "unit": "boolean"
        },
        "time_budget_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Soft deterministic between-stage ceiling; must be below the hard supervisor timeout.",
          "network_impact": "none",
          "scope": "deterministic_between_stages",
          "supported": true,
          "title": "Time Budget Seconds",
          "unit": "seconds"
        },
        "analyzer_profile": {
          "anyOf": [
            {
              "maxLength": 160,
              "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "network_impact": "none",
          "supported": true,
          "title": "Analyzer Profile",
          "unit": "qualified_profile_name"
        }
      },
      "title": "ScanOptionsV15",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.2",
      "title": "Schema Version",
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ]
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "repository_id": {
      "minLength": 1,
      "title": "Repository Id",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "kind": {
      "const": "request",
      "default": "request",
      "title": "Kind",
      "type": "string"
    },
    "repository_path": {
      "minLength": 1,
      "title": "Repository Path",
      "type": "string"
    },
    "output_path": {
      "minLength": 1,
      "title": "Output Path",
      "type": "string"
    },
    "modules": {
      "items": {
        "type": "string"
      },
      "title": "Modules",
      "type": "array"
    },
    "options": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScanOptionsV15"
        },
        {
          "$ref": "#/$defs/ScanOptionsV13"
        },
        {
          "$ref": "#/$defs/ScanOptionsV12"
        },
        {
          "$ref": "#/$defs/ScanOptions"
        }
      ],
      "title": "Options"
    }
  },
  "required": [
    "run_id",
    "repository_id",
    "generation",
    "revision",
    "repository_path",
    "output_path"
  ],
  "title": "RunRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
