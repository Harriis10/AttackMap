{
  "properties": {
    "schema_version": {
      "default": "1.2",
      "title": "Schema Version",
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ]
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "repository_id": {
      "minLength": 1,
      "title": "Repository Id",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "kind": {
      "const": "progress",
      "default": "progress",
      "title": "Kind",
      "type": "string"
    },
    "state": {
      "enum": [
        "queued",
        "running",
        "cancelling"
      ],
      "title": "State",
      "type": "string"
    },
    "stage": {
      "default": "",
      "title": "Stage",
      "type": "string"
    },
    "completed_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed Units"
    },
    "total_units": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Units"
    }
  },
  "required": [
    "run_id",
    "repository_id",
    "generation",
    "revision",
    "state"
  ],
  "title": "RunProgress",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
