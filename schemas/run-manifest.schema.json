{
  "$defs": {
    "RunArtifact": {
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "media_type",
        "sha256",
        "size_bytes"
      ],
      "title": "RunArtifact",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.2",
      "title": "Schema Version",
      "type": "string",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ]
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "repository_id": {
      "minLength": 1,
      "title": "Repository Id",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "kind": {
      "const": "manifest",
      "default": "manifest",
      "title": "Kind",
      "type": "string"
    },
    "artifact_readiness": {
      "const": "ready",
      "default": "ready",
      "title": "Artifact Readiness",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/RunArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "repository_id",
    "generation",
    "revision",
    "artifacts"
  ],
  "title": "RunArtifactManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
